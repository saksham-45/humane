{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "outDir": "../../public/js",
    "rootDir": ".",
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["./api.ts", "./board.ts", "./fixture.ts", "./play.ts", "./sweep.ts", "./types.ts"],
  "exclude": ["./**/*.mjs", "./app.ts", "./cut.ts", "./spring.ts"]
}
