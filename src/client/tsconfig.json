{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "outDir": "../../public/js",
    "rootDir": ".",
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["./**/*.mjs"]
}
